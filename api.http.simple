# API

## 1.Admin

### 1.1 Login
POST http://localhost:9092/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_LOGIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_LOGIN_PASSWORD}}",
    "rememberMe": false
}

### 1.2 Signup
// ใช้ได้เฉพาะตอนที่ยังไม่มี Super Admin (ครั้งแรกหลัง setup เท่านั้น)
POST http://localhost:9092/admin/register-admin
Content-Type: application/json

{
    "firstname": "{{$dotenv ADMIN_REGISTER_FIRSTNAME}}",
    "lastname": "{{$dotenv ADMIN_REGISTER_LASTNAME}}",
    "email": "{{$dotenv ADMIN_REGISTER_EMAIL}}",
    "password": "{{$dotenv ADMIN_REGISTER_PASSWORD}}"
}

### 1.3 Forgot Password
POST http://localhost:9092/admin/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_FORGOT_EMAIL}}"
}

### 1.3.1 Reset Password
// เอา token (query param ชื่อ code) จากลิงก์ในอีเมลที่ 1.3 ส่งกลับไปใส่ใน field resetPasswordToken
POST http://localhost:9092/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{$dotenv ADMIN_RESET_PASSWORD_TOKEN}}",
    "password": "{{$dotenv ADMIN_RESET_PASSWORD}}"
}

### 1.4 Profile
// เอา token จาก response ของข้อ 1.1 ไปใส่ใน .env ที่ ADMIN_PROFILE_TOKEN
GET http://localhost:9092/admin/users/me
Authorization: Bearer {{$dotenv ADMIN_PROFILE_TOKEN}}

## 2.User

### 2.1 Login
POST http://localhost:9092/api/auth/local
Content-Type: application/json

{
    "identifier": "{{$dotenv USER_LOGIN_IDENTIFIER}}",
    "password": "{{$dotenv USER_LOGIN_PASSWORD}}"
}

### 2.2 Signup
POST http://localhost:9092/api/auth/local/register
Content-Type: application/json

{
    "username": "{{$dotenv USER_REGISTER_USERNAME}}",
    "email": "{{$dotenv USER_REGISTER_EMAIL}}",
    "password": "{{$dotenv USER_REGISTER_PASSWORD}}"
}

### 2.3 Forgot Password
// Strapi จะคืน 500 ถ้ายังไม่ได้ตั้งค่า SMTP สำหรับส่งอีเมล
POST http://localhost:9092/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv USER_FORGOT_EMAIL}}"
}

### 2.3.1 Reset Password
// เอา code จากลิงก์ในอีเมลที่ 2.3 ส่งกลับไปใส่ใน field code
POST http://localhost:9092/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{$dotenv USER_RESET_PASSWORD_CODE}}",
    "password": "{{$dotenv USER_RESET_PASSWORD}}",
    "passwordConfirmation": "{{$dotenv USER_RESET_PASSWORD_CONFIRMATION}}"
}

### 2.4 Profile
// เอา jwt จาก response ของข้อ 2.1 ไปใส่ใน .env ที่ USER_PROFILE_TOKEN
GET http://localhost:9092/api/users/me
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

## 3.Content

### 3.1 Student
#### 3.1.1 Create Student
POST http://localhost:9092/api/students
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv STUDENT_CREATE_NAME}}",
        "mobile": "{{$dotenv STUDENT_CREATE_MOBILE}}",
        "cardId": "{{$dotenv STUDENT_CREATE_CARD_ID}}"
    }
}

#### 3.1.2 Get all Student
GET http://localhost:9092/api/students
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.1.3 Get Student by ID
GET http://localhost:9092/api/students/{{$dotenv STUDENT_ID}}
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.1.4 Update Student
PUT http://localhost:9092/api/students/{{$dotenv STUDENT_ID}}
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv STUDENT_UPDATE_NAME}}",
        "mobile": "{{$dotenv STUDENT_UPDATE_MOBILE}}",
        "cardId": "{{$dotenv STUDENT_UPDATE_CARD_ID}}"
    }
}

#### 3.1.5 Delete Student
DELETE http://localhost:9092/api/students/{{$dotenv STUDENT_ID}}
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

### 3.2 Teacher
#### 3.2.1 Create Teacher
POST http://localhost:9092/api/teachers
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv TEACHER_CREATE_NAME}}"
    }
}

#### 3.2.2 Get all Teacher
GET http://localhost:9092/api/teachers
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.2.3 Get Teacher by ID
GET http://localhost:9092/api/teachers/{{$dotenv TEACHER_ID}}
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.2.4 Update Teacher
PUT http://localhost:9092/api/teachers/{{$dotenv TEACHER_ID}}
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv TEACHER_UPDATE_NAME}}"
    }
}

#### 3.2.5 Delete Teacher
DELETE http://localhost:9092/api/teachers/{{$dotenv TEACHER_ID}}
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

### 3.3 Subject
#### 3.3.1 Create Subject
POST http://localhost:9092/api/subjects
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv SUBJECT_CREATE_NAME}}"
    }
}

#### 3.3.2 Get all Subject
GET http://localhost:9092/api/subjects
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.3.3 Get Subject by ID
GET http://localhost:9092/api/subjects/{{$dotenv SUBJECT_ID}}
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

#### 3.3.4 Update Subject
PUT http://localhost:9092/api/subjects/{{$dotenv SUBJECT_ID}}
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_PROFILE_TOKEN}}

{
    "data": {
        "name": "{{$dotenv SUBJECT_UPDATE_NAME}}"
